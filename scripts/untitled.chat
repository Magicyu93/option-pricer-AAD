            "raw_output": "40\t                       refresh=REFRESH, data_dir=DATA_DIR, on_progress=print)\n41\t--out: equity 2026-09-08: 252,847 rows\n42\tequity 2026-09-09: 251,238 rows\n43\tequity 2026-09-10: 287,537 rows\n44\tequity 2026-09-11: 272,171 rows\n45\trates (massive) 2026-08-25 to 2026-09-11: 91 rows\n46\tdividends SPY 2026-09-08 to 2027-09-11: 1 rows\n47\tdividends SPX: index, no dividends: skipped\n48\t\n49\t=== [3] code exec=17\n50\tfrom data_pipeline.option_equity_historical_data_loader import MassiveHistoricalDataLoader\n51\t\n52\tloader = MassiveHistoricalDataLoader(data_dir=DATA_DIR)\n53\t\n54\tmarket = loader.load_market(\n55\t    dates=\"2026-09-08\",\n56\t    tickers=[\"SPXW\", \"SPX\"],\n57\t)\n58\t\n59\t\n60\t=== [4] code exec=18\n61\tmarket\n62\t--data keys: ['text/html', 'text/plain']        session_date                 timestamp underlying option_root  \\\n63\t0        2026-09-08 2026-09-08 09:30:00-04:00        SPX        SPXW   \n64\t1        2026-09-08 2026-09-08 09:30:00-04:00        SPX        SPXW   \n65\t2        2026-09-08 2026-09-08 09:30:00-04:00        SPX        SPXW   \n66\t3        2026-09-08 2026-09-08 09:30:00-04:00        SPX        SPXW   \n67\t4        2026-09-08 2026-09-08 09:30:00-04:00        SPX        SPXW   \n68\t...             ...                       ...        ...         ...\n69\t=== [5] code exec=66\n70\t### filter the calibration to time between 3:30 pm to 4: 00 pm\n71\tfrom datetime import time\n72\t\n73\tCALIB_START = time(15, 30)\n74\tCALIB_END = time(16, 0)  # exclusive: the 15:59 minute bar covers up to 16:00\n75\t\n76\tbar_time = market.timestamp.dt.tz_convert(\"America/New_York\").dt.time\n77\tin_window = (bar_time >= CALIB_START) & (bar_time <= CALIB_END)\n78\t\n79\tdf_calibration = market[(market.option_root == \"SPXW\") & in_window]\n80\tassert not df_calibration.empty, \"no SPXW bars in the 15:30-16:00 calibration window\"\n81\tdf_calibration\n82\t\n83\t--data keys: ['text/html', 'text/plain']        session_date                 timestamp underlying option_root  \\\n84\t113573   2026-09-08 2026-09-08 15:30:00-04:00        SPX        SPXW   \n85\t113574   2026-09-08 2026-09-08 15:30:00-04:00        SPX        SPXW   \n86\t113575   2026-09-08 2026-09-08 15:30:00-04:00        SPX        SPXW   \n87\t113576   2026-09-08 2026-09-08 15:30:00-04:00        SPX        SPXW   \n88\t113577   2026-09-08 2026-09-08 15:30:00-04:00        SPX        SPXW   \n89\t...             ...                       ...        ...         ...\n90\t=== [6] code exec=77\n91\t### slice the call put parity pairs\n92\t# One row per (minute, expiry, strike) where both the call and the put traded in that\n93\t# minute, with parity = C - P. Box-spread prints (2 strikes in the minute, all 4 legs\n94\t# with the same volume) are flagged: they are traded as one package, so they price the\n95\t# box financing rate, which runs ~10-55bp above T-bills.\n96\timport numpy as np\n97\timport pandas as pd\n98\t\n99\tMONEYNESS_BAND = 0.10  # keep |K / S - 1| < 10%, far wing trade prints are stale\n100\tYEAR_SECONDS = 365 * 24 * 3600\n101\t\n102\t\n103\tdef build_parity_pairs(df: pd.DataFrame) -> pd.DataFrame:\n104\t    keys = [\"timestamp\", \"option_root\", \"expiration\", \"strike\"]\n105\t    prices = df.pivot_table(index=keys, columns=\"option_type\", values=\"option_close\", aggfunc=\"last\")\n106\t    volumes = df.pivot_table(index=keys, columns=\"option_type\", values=\"option_volume\", aggfunc=\"sum\")\n107\t    pairs = (\n108\t        prices.join(volumes.add_suffix(\"_volume\"))\n109\t        .dropna(subset=[\"call\", \"put\"])\n110\t        .join(df.groupby(keys).underlying_close.last().rename(\"spot\"))\n111\t        .dropna(subset=[\"spot\"])\n112\t        .reset_index()\n113\t    )\n114\t    pairs[\"strike\"] = pairs[\"strike\"].astype(float)  # nullable Float64 -> float\n115\t    pairs[\"parity\"] = pairs[\"call\"] - pairs[\"put\"]\n116\t\n117\t    # SPXW is PM-settled: expiry at 16:00 ET on the expiration date\n118\t    expiry_ts = (pairs.expiration + pd.Timedelta(hours=16)).dt.tz_localize(\"America/New_York\")\n119\t    pairs[\"T\"] = (expiry_ts - pairs.timestamp).dt.total_seconds() / YEAR_SECONDS\n120\t    pairs = pairs[(pairs[\"T\"] > 0) & ((pairs.strike / pairs.spot - 1).abs() < MONEYNESS_BAND)]\n121\t\n122\t    # the per-minute intercept needs at least 2 strikes in the same (expiry, minute)\n123\t    by_minute = [\"option_root\", \"expiration\", \"timestamp\"]\n124\t    pairs = pairs[pairs.groupby(by_minute).strike.transform(\"size\") >= 2].copy()\n125\t\n126\t    grouped = pairs.groupby(by_minute)\n127\t    one_volume = (\n128\t        (pairs.call_volume == pairs.put_volume)\n129\t        & (grouped.call_volume.transform(\"nunique\") == 1)\n130\t        & (grouped.put_volume.transform(\"nunique\") == 1)\n131\t    )\n132\t    pairs[\"is_box\"] = (grouped.strike.transform(\"size\") == 2) & one_volume\n133\t    return pairs.reset_index(drop=True)\n134\t\n135\t\n136\tparity_pairs = build_parity_pairs(market[market.option_root == \"SPXW\"])\n137\tprint(f\"{len(parity_pairs)} pairs, {parity_pairs.is_box.sum()} in box prints, \"\n138\t      f\"{parity_pairs.expiration.nunique()} expiries\")\n139\tparity_pairs\n140\t--out: 13907 pairs, 68 in box prints, 22 expiries\n141\t\n142\t--data keys: ['text/html', 'text/plain']                       timestamp option_root expiration  strike    call    put  \\\n143\t0     2026-09-08 09:30:00-04:00        SPXW 2026-09-08  7450.0  256.52   0.10   \n144\t1     2026-09-08 09:30:00-04:00        SPXW 2026-09-08  7455.0  251.74   0.10   \n145\t2     2026-09-08 09:30:00-04:00        SPXW 2026-09-08  7565.0  145.30   0.17   \n146\t3     2026-09-08 09:30:00-04:00        SPXW 2026-09-08  7570.0  140.50   0.20   \n147\t4     2026-09-08 09:30:00-04:00        SPXW 2026-09-08  7575.0  134.00   0.22   \n148\t...           \n149\t=== [7] code exec=79\n150\t### regress the call put parity to get the discount factor, per expiry\n151\t# Parity: C - P = A_t - D * K, with D = exp(-r T) and A_t = S_t * exp(-q T).\n152\t# Per (root, expiry), OLS of (C - P) on K with one intercept A_t per minute (spot moves\n153\t# between minutes, so a single intercept would be wrong). Demeaning within each minute\n154\t# gives the slope without estimating every intercept: -D = sum(K_dm * P_dm) / sum(K_dm^2).\n155\t# The intercepts then come back as A_t = mean(C - P) + D * mean(K), and A_t / S_t\n156\t# estimates exp(-q T). Then r = -ln(D) / T and q = -ln(A_t / S_t) / T, both continuous.\n157\t\n158\t\n159\tdef regress_parity(pairs: pd.DataFrame, exclude_boxes: bool = False) -> dict:\n160\t    p = pairs[~pairs.is_box] if exclude_boxes else pairs\n161\t    by_minute = [\"option_root\", \"expiration\", \"timestamp\"]\n162\t    p = p[p.groupby(by_minute).strike.transform(\"size\") >= 2]\n163\t    empty = {\"discount\": np.nan, \"discount_se\": np.nan, \"div_discount\": np.nan,\n164\t             \"div_discount_se\": np.nan, \"r\": np.nan, \"r_se\": np.nan, \"q\": np.nan, \"q_se\": np.nan,\n165\t             \"T\": np.nan, \"n_pairs\": 0, \"n_minutes\": 0}\n166\t    if p.empty:\n167\t        return empty\n168\t    grouped = p.groupby(by_minute)\n169\t    k_dm = (p.strike - grouped.strike.transform(\"mean\")).to_numpy()\n170\t    p_dm = (p.parity - grouped.parity.transform(\"mean\")).to_numpy()\n171\t\n172\t    discount = -(k_dm @ p_dm) / (k_dm @ k_dm)\n173\t    resid = p_dm + discount * k_dm\n174\t\n175\t    # minute-clustered standard error: trades in one minute share spot and timing noise\n176\t    n_minutes = grouped.ngroups\n177\t    cluster_score = pd.Series(k_dm * resid).groupby(grouped.ngroup().to_numpy()).sum()\n178\t    discount_se = np.sqrt((cluster_score**2).sum()) / (k_dm @ k_dm)\n179\t    if n_minutes < 2 or len(p) - n_minutes - 1 <= 0:\n180\t        discount_se = np.nan  # an exact fit (e.g. one box print) has no residual to measure noise from\n181\t\n182\t    # per-minute intercepts A_t, scaled by that minute's spot\n183\t    minute = grouped.agg(parity=(\"parity\", \"mean\"), strike=(\"strike\", \"mean\"), spot=(\"spot\", \"first\"))\n184\t    div_discount_t = (minute.parity + discount * minute.strike) / minute.spot\n185\t    # spread across minutes, plus the error in D carried through D * mean(K) / S_t\n186\t    div_discount_se = np.sqrt(\n187\t        div_discount_t.var() / n_minutes + (discount_se * (minute.strike / minute.spot).mean()) ** 2\n188\t    )\n189\t    div_discount = div_discount_t.mean()\n190\t\n191\t    # continuous rate and dividend yield; se via d(-ln x / T) = dx / (x T)\n192\t    T = p[\"T\"].mean()\n193\t    return {\"discount\": discount, \"discount_se\": discount_se,\n194\t            \"div_discount\": div_discount, \"div_discount_se\": div_discount_se,\n195\t            \"r\": -np.log(discount) / T, \"r_se\": discount_se / (discount * T),\n196\t            \"q\": -np.log(div_discount) / T, \"q_se\": div_discount_se / (div_discount * T),\n197\t            \"T\": T, \"n_pairs\": len(p), \"n_minutes\": n_minutes}\n198\t\n199\t\n200\trows = {}\n201\tfor (root, expiration), g in parity_pairs.groupby([\"option_root\", \"expiration\"]):\n202\t    fit = regress_parity(g)\n203\t    fit[\"discount_ex_boxes\"] = regress_parity(g, exclude_boxes=True)[\"discount\"]\n204\t    rows[(root, expiration)] = fit\n205\tparity_fit = pd.DataFrame(rows).T.rename_axis([\"option_root\", \"expiration\"]).sort_index(level=\"expiration\")\n206\tparity_fit\n207\t--data keys: ['text/html', 'text/plain']                         discount  discount_se  div_discount  div_discount_se  \\\n208\toption_root expiration                                                         \n209\tSPXW        2026-09-08  0.999717     0.000372      0.999662         0.000372   \n210\t            2026-09-09  0.999983     0.000561      0.999977         0.000561   \n211\t            2026-09-10  1.000526     0.001315      1.000511         0.001316   \n212\t            2026-09-11  0.999016     0.000496      0.999231         0.000496   \n213\t            2026-09-\n214\t=== [8] code exec=89\n215\t### plot the call put parity regression, per expiry\n216\t# One panel per (root, expiry): raw C - P against strike K. The fitted line has slope -D\n217\t# from regress_parity. Spot moves between minutes, which shifts each minute's intercept\n218\t# A_t by a few points, so the line uses the average intercept mean(C - P + D * K).\n219\timport matplotlib.pyplot as plt\n220\timport matplotlib.dates as mdates\n221\t\n222\tSURFACE, INK, INK_2, MUTED, GRID = \"#fcfcfb\", \"#0b0b0b\", \"#52514e\", \"#898781\", \"#e1e0d9\"\n223\tPAIR_COLOR, BOX_COLOR = \"#2a78d6\", \"#eb6834\"  # categorical slots 1-2, validated all-pairs\n224\t\n225\tplt.rcParams.update({\n226\t    \"figure.facecolor\": SURFACE, \"axes.facecolor\": SURFACE, \"axes.edgecolor\": MUTED,\n227\t    \"axes.labelcolor\": INK_2, \"xtick.color\": MUTED, \"ytick.color\": MUTED, \"text.color\": INK,\n228\t    \"axes.grid\": True, \"grid.color\": GRID, \"grid.linewidth\": 0.6,\n229\t    \"axes.spines.top\": False, \"axes.spines.right\": False, \"font.size\": 9,\n230\t})\n231\t\n232\t\n233\tdef plot_parity_regression(pairs: pd.DataFrame, n_cols: int = 6, share_axes: bool = True):\n234\t    \"\"\"C - P against K for every (root, expiry) in ``pairs``, with the fitted line -D * K + A.\"\"\"\n235\t    by_minute = [\"option_root\", \"expiration\", \"timestamp\"]\n236\t    pairs = pairs[pairs.groupby(by_minute).strike.transform(\"size\") >= 2]\n237\t    groups = sorted(pairs.groupby([\"option_root\", \"expiration\"]), key=lambda kv: kv[1][\"T\"].mean())\n238\t    n_rows = -(-len(groups) // n_cols)\n239\t    fig, axes = plt.subplots(n_rows, n_cols, figsize=(3 * n_cols, 2.6 * n_rows),\n240\t                             sharex=share_axes, sharey=share_axes, squeeze=False)\n241\t\n242\t    for ax, ((root, expiration), g) in zip(axes.flat, groups):\n243\t        fit = regress_parity(g)\n244\t        D, T = fit[\"discount\"], fit[\"T\"]\n245\t        is_box = g.is_box.to_numpy()\n246\t        ring = {\"edgecolors\": SURFACE, \"linewidths\": 0.6}\n247\t        ax.scatter(g.strike[~is_box], g.parity[~is_box], s=14, color=PAIR_COLOR, alpha=0.45,\n248\t                   label=\"pair\", **ring)\n249\t        ax.scatter(g.strike[is_box], g.parity[is_box], s=30, color=BOX_COLOR, label=\"box print\", **ring)\n250\t\n251\t        intercept = (g.parity + D * g.strike).mean()\n252\t        line_x = np.array([g.strike.min(), g.strike.max()])\n253\t        ax.plot(line_x, intercept - D * line_x, color=INK_2, linewidth=1.5, label=\"fit, slope = -D\")\n254\t        ax.set_title(f\"{root} {expiration:%Y-%m-%d}  ({T * 365:.1f}d, n={len(g)})\\n\"\n255\t                     f\"D = {D:.5f}, r = {fit['r']:.2%}\", fontsize=8, color=INK)\n256\t\n257\t    for ax in axes.flat[len(groups):]:\n258\t        ax.set_visible(False)\n259\t    for ax in axes[-1, :]:\n260\t        ax.set_xlabel(\"strike K\")\n261\t    for ax in axes[:, 0]:\n262\t        ax.set_ylabel(\"C - P\")\n263\t    axes[0, 0].legend(loc=\"lower left\", fontsize=7, facecolor=SURFACE, edgecolor=\"none\", framealpha=1)\n264\t    fig.suptitle(\"Call - put parity by expiry: C - P = A - D * K\", color=INK, x=0.01, ha=\"left\")\n265\t    fig.tight_layout(rect=(0, 0, 1, 0.98))\n266\t    return fig\n267\t\n268\t\n269\t### plot where the call put parity pairs are\n270\t# Left: each pair by time of day and days to expiry (log). Right: number of pairs per\n271\t# (root, expiry), sorted by expiry. Box prints are drawn on top in the second color.\n272\tdef plot_parity_coverage(pairs: pd.DataFrame):\n273\t    \"\"\"Coverage of ``pairs``: when they traded, how far out, and how many per expiry.\"\"\"\n274\t    is_box = pairs.is_box.to_numpy()\n275\t    days = (pairs[\"T\"] * 365).to_numpy()\n276\t    ring = {\"edgecolors\": SURFACE, \"linewidths\": 0.6}\n277\t\n278\t    fig, (ax_time, ax_count) = plt.subplots(1, 2, figsize=(13, 4.2), gridspec_kw={\"width_ratios\": [1.3, 1]})\n279\t    ax_time.scatter(pairs.timestamp[~is_box], days[~is_box], s=14, color=PAIR_COLOR, alpha=0.45,\n280\t                    label=\"pair\", **ring)\n281\t    ax_time.scatter(pairs.timestamp[is_box], days[is_box], s=30, color=BOX_COLOR, label=\"box print\", **ring)\n282\t    ax_time.set_yscale(\"log\")\n283\t    ax_time.xaxis.set_major_formatter(mdates.DateFormatter(\"%H:%M\", tz=pairs.timestamp.dt.tz))\n284\t    ax_time.set(xlabel=\"time of day (ET)\", ylabel=\"days to expiry (log)\",\n285\t                title=\"When and how far out the matched pairs are\")\n286\t    ax_time.legend(loc=\"upper left\", bbox_to_anchor=(1.0, 1.0), frameon=False)\n287\t\n288\t    counts = pairs.groupby([\"option_root\", \"expiration\"]).size().sort_index(level=\"expiration\")\n289\t    labels = [f\"{e:%m-%d}\" + (\"\" if root == \"SPXW\" else \" SPX\") for root, e in counts.index]\n290\t    ax_count.bar(range(len(counts)), counts.to_numpy(), color=PAIR_COLOR, width=0.8)\n291\t    ax_count.set_yscale(\"log\")\n292\t    ax_count.set_xticks(range(len(counts)), labels, rotation=90, fontsize=7)\n293\t    ax_count.set(ylabel=\"pairs (log)\", title=\"Pairs per expiry\")\n294\t    ax_count.grid(axis=\"x\", visible=False)\n295\t\n296\t    fig.suptitle(f\"{len(pairs):,} call/put pairs traded in the same minute\", color=INK, x=0.01, ha=\"left\")\n297\t    fig.tight_layout()\n298\t    return fig\n299\t\n300\t\n301\tfig = plot_parity_coverage(parity_pairs)\n302\tplt.show()\n303\t\n304\t\n305\tfig = plot_parity_regression(parity_pairs)\n306\tplt.show()\n307\t--data keys: ['image/png', 'text/plain'] <Figure size 1300x420 with 2 Axes>\n308\t--data keys: ['image/png', 'text/plain'] <Figure size 1800x1040 with 24 Axes>\n309\t=== [9] code exec=119\n310\t### getting the treasury rates curve\n311\t\n312\tfrom data_pipeline.download import download_rates\n313\tfrom data_pipeline.rates import TREASURY_CMT_SERIES, TREASURY_TENORS, RatesDataLoader\n314\t\n315\tpar = RatesDataLoader(RATES_PROVIDER, data_dir=DATA_DIR).yields_as_of(\"2026-09-08\", lag_days=0)\n316\ttreasury_zero_rate_curve = treasury_zero_curve(par.tenors, par.yields_pct)\n317\ttreasury_zero_rate_curve\n318\t--data keys: ['text/plain'] RateCurve('UST', 7 pillars)\n319\t=== [10] code exec=118\n320\tT = np.array([7 / 365, 0.2, 0.3, 0.5, 1.0, 2.0, 20.0])\n321\tzero = treasury_curve.instantaneous_forward(T).detach().numpy()     \n322\tzero\n323\t--data keys: ['text/plain'] array([0.03803964, 0.03979101, 0.04171698, 0.04171698, 0.04589344,\n324\t       0.04654367, 0.05819437])\n325\t=== [11] code exec=115\n326\tpar.yields_pct\n327\t--data keys: ['text/plain'] array([3.81, 3.94, 4.15, 4.39, 4.57, 4.8 , 5.25])\n328\t=== [12] code exec=120\n329\t### plot a rate curve's par, zero and instantaneous forward rates\n330\t# All three are views of one discount function D(T), so the curve alone defines them:\n331\t#   zero     r(T) = -ln D(T) / T\n332\t#   forward  f(T) = -d ln D / dT (here over a one-basis-point-of-a-year window)\n333\t#   par      up to 6M a bill yield (1 / D(T) - 1) / T; beyond, the semiannual coupon that\n334\t#            prices a bond at par, 2 (1 - D(T)) / sum_i D(t_i) over t_i = 0.5, 1.0, ..., T.\n335\t# The curve's par yields are not the published ones: it keeps zeros only at the quoted\n336\t# tenors, so coupon dates in between are interpolated (up to ~8bp apart at 30Y).\n337\t# Pass ``published`` (a ParYieldSnapshot) to overlay what Treasury actually quoted.\n338\timport matplotlib.pyplot as plt\n339\tfrom matplotlib.ticker import FixedLocator, FuncFormatter, NullLocator\n340\t\n341\tSURFACE, INK, INK_2, MUTED, GRID = \"#fcfcfb\", \"#0b0b0b\", \"#52514e\", \"#898781\", \"#e1e0d9\"\n342\tPAR_COLOR, ZERO_COLOR, FORWARD_COLOR = \"#2a78d6\", \"#eb6834\", \"#1baf7a\"  # categorical slots 1-3\n343\tTENOR_LABELS = {1 / 52: \"1W\", 1 / 12: \"1M\", 0.25: \"3M\", 0.5: \"6M\", 1: \"1Y\", 2: \"2Y\", 3: \"3Y\", 5: \"5Y\",\n344\t                7: \"7Y\", 10: \"10Y\", 20: \"20Y\", 30: \"30Y\"}\n345\tCOUPON_PERIOD = 0.5\n346\t\n347\t\n348\tdef par_rates(curve, max_tenor: float) -> tuple[np.ndarray, np.ndarray]:\n349\t    \"\"\"The curve's par yields: bills on a fine grid to 6M, then every half-year coupon tenor.\"\"\"\n350\t    bills = np.geomspace(1 / 52, COUPON_PERIOD, 60)\n351\t    bill_par = (1.0 / curve.discount(bills).detach().numpy() - 1.0) / bills\n352\t    coupon_dates = COUPON_PERIOD * np.arange(1, int(round(max_tenor / COUPON_PERIOD)) + 1)\n353\t    dfs = curve.discount(coupon_dates).detach().numpy()\n354\t    bond_par = (1.0 - dfs) / (COUPON_PERIOD * np.cumsum(dfs))  # tenor t_n uses coupons t_1..t_n\n355\t    return np.concatenate([bills, coupon_dates[1:]]), np.concatenate([bill_par, bond_par[1:]])\n356\t\n357\t\n358\tdef plot_rate_curves(curve, max_tenor: float | None = None, published=None, title: str | None = None):\n359\t    \"\"\"Par, zero and instantaneous forward rates of ``curve``, on one rates axis.\"\"\"\n360\t    pillars = curve.pillar_times.numpy()\n361\t    max_tenor = float(max_tenor or pillars.max())\n362\t    # stop one forward bump short of the end: past the last pillar the curve is flat by construction\n363\t    t = np.geomspace(1 / 52, max_tenor - 2e-4, 600)\n364\t    zero = 100 * curve.zero_rate(t).detach().numpy()\n365\t    forward = 100 * curve.instantaneous_forward(t).detach().numpy()\n366\t    par_t, par = par_rates(curve, max_tenor)\n367\t    par = 100 * par\n368\t\n369\t    fig, ax = plt.subplots(figsize=(9, 4.8), facecolor=SURFACE)\n370\t    ax.set_facecolor(SURFACE)\n371\t    ax.plot(t, forward, color=FORWARD_COLOR, linewidth=2, label=\"instantaneous forward f(T)\")\n372\t    ax.plot(t, zero, color=ZERO_COLOR, linewidth=2, label=\"zero rate r(T)\")\n373\t    ax.scatter(pillars, 100 * curve.pillar_zeros.detach().numpy(), s=40, color=ZERO_COLOR,\n374\t               edgecolors=SURFACE, linewidths=2, zorder=3, label=\"curve pillars\")\n375\t    ax.plot(par_t, par, color=PAR_COLOR, linewidth=2, label=\"par yield (implied by the curve)\")\n376\t    if published is not None:\n377\t        ax.scatter(published.tenors, published.yields_pct, s=48, marker=\"D\", facecolors=SURFACE,\n378\t                   edgecolors=PAR_COLOR, linewidths=1.5, zorder=4, label=\"par yield (published)\")\n379\t\n380\t    # direct labels at the long end, in ink, next to each series' last point\n381\t    for value, name in [(forward[-1], \"forward\"), (zero[-1], \"zero\"), (par[-1], \"par\")]:\n382\t        ax.annotate(f\"{name} {value:.2f}%\", (max_tenor, value), xytext=(8, 0), textcoords=\"offset points\",\n383\t                    va=\"center\", fontsize=8.5, color=INK_2, annotation_clip=False)\n384\t\n385\t    ax.set_xscale(\"log\")\n386\t    ax.xaxis.set_major_locator(FixedLocator([x for x in TENOR_LABELS if x <= max_tenor]))\n387\t    ax.xaxis.set_minor_locator(NullLocator())\n388\t    ax.xaxis.set_major_formatter(FuncFormatter(lambda x, _: TENOR_LABELS.get(x, \"\")))\n389\t    ax.yaxis.set_major_formatter(FuncFormatter(lambda y, _: f\"{y:.2f}%\"))\n390\t    ax.set_xlim(t[0], max_tenor)\n391\t    ax.set_xlabel(\"maturity\", color=INK_2)\n392\t    ax.set_ylabel(\"rate\", color=INK_2)\n393\t    ax.grid(True, color=GRID, linewidth=0.6)\n394\t    ax.tick_params(colors=MUTED)\n395\t    for side in (\"top\", \"right\"):\n396\t        ax.spines[side].set_visible(False)\n397\t    for side in (\"left\", \"bottom\"):\n398\t        ax.spines[side].set_color(MUTED)\n399\t    ax.legend(loc=\"upper left\", frameon=False, fontsize=8.5, labelcolor=INK_2)\n400\t    ax.set_title(title or f\"{curve.label} curve: par, zero and forward rates\", loc=\"left\", color=INK)\n401\t    fig.tight_layout()\n402\t    return fig\n403\t\n404\t\n405\tfig = plot_rate_curves(discount_curve, published=par)\n406\tplt.show()\n407\t--data keys: ['image/png', 'text/plain'] <Figure size 900x480 with 1 Axes>\n408\t=== [13] code exec=121\n409\t### computing the implied vol for each contract, using the treasury implied zero rate curve\n410\t=== [14] code exec=122\n411\tdf_calibration\n412\t--data keys: ['text/html', 'text/plain']        session_date                 timestamp underlying option_root  \\\n413\t113573   2026-09-08 2026-09-08 15:30:00-04:00        SPX        SPXW   \n414\t113574   2026-09-08 2026-09-08 15:30:00-04:00        SPX        SPXW   \n415\t113575   2026-09-08 2026-09-08 15:30:00-04:00        SPX        SPXW   \n416\t113576   2026-09-08 2026-09-08 15:30:00-04:00        SPX        SPXW   \n417\t113577   2026-09-08 2026-09-08 15:30:00-04:00        SPX        SPXW   \n418\t...             ...                       ...        ...         ...\n419\t=== [15] code exec=123\n420\t### computing the implied vol for each contract, using the treasury implied zero rate curve\n421\t# Each row of df_calibration is one contract's trade bar in one minute. For each row:\n422\t#   T   time from the bar's minute to the contract's settlement, in years (ACT/365):\n423\t#       SPXW settle at the 16:00 close (PM), SPX monthlies at the 09:30 open (AM)\n424\t#   r   the Treasury zero rate to T; D = exp(-r T)\n425\t#   F   the forward grown from that minute's spot, F = S exp((r - q) T), q a flat dividend yield\n426\t#   iv  Black-76 inversion of the bar's close price on (F, K, T, D)\n427\t# contract_implied_vols keeps every bar; contract_vol_summary averages each contract's vol over\n428\t# its bars by volume, and flags the out-of-the-money side, the one a vol surface is fitted to.\n429\timport numpy as np\n430\timport pandas as pd\n431\t\n432\tfrom data_pipeline.rates import RatesDataLoader\n433\tfrom torch_pricer.black_formula import implied_vol\n434\tfrom torch_pricer.instruments.listed import Settlement, listed_product\n435\tfrom torch_pricer.market.curve import treasury_zero_curve\n436\t\n437\tTIMEZONE = \"America/New_York\"\n438\tYEAR_SECONDS = 365 * 24 * 3600  # ACT/365, the library's default day count\n439\tMARKET_CLOSE = pd.Timedelta(hours=16)\n440\tDIVIDEND_YIELD = 0.011  # flat continuous SPX dividend yield\n441\tPRODUCT = listed_product(\"SPX\")  # SPX monthlies AM-settled, SPXW weeklies PM-settled\n442\t\n443\t\n444\tdef time_to_settlement(observed_at: pd.Series, expiry: pd.Series, settlement: pd.Series) -> np.ndarray:\n445\t    \"\"\"Years from each observation to its contract's settlement time on the expiry date.\"\"\"\n446\t    hours_early = settlement.map(lambda s: Settlement(s).hours_before_close())\n447\t    settles_at = (\n448\t        pd.to_datetime(expiry).dt.tz_localize(TIMEZONE) + MARKET_CLOSE\n449\t        - pd.to_timedelta(hours_early, unit=\"h\")\n450\t    )\n451\t    return (settles_at - observed_at.dt.tz_convert(TIMEZONE)).dt.total_seconds().to_numpy() / YEAR_SECONDS\n452\t\n453\t\n454\tdef curve_forward(spot, T, curve, dividend_yield: float = DIVIDEND_YIELD):\n455\t    \"\"\"Zero rate r(T), discount D = exp(-r T) and forward F = S exp((r - q) T) from ``curve``.\"\"\"\n456\t    T = np.asarray(T, dtype=float)\n457\t    r = curve.zero_rate(np.maximum(T, 0.0)).detach().numpy()\n458\t    discount = np.exp(-r * T)\n459\t    forward = np.asarray(spot, dtype=float) * np.exp((r - dividend_yield) * T)\n460\t    return r, discount, forward\n461\t\n462\t\n463\tdef contract_implied_vols(df: pd.DataFrame, curve, product=PRODUCT,\n464\t                          dividend_yield: float = DIVIDEND_YIELD) -> pd.DataFrame:\n465\t    \"\"\"``df`` (load_market rows) with settlement, T, r, discount, forward, k = ln(K/F) and iv.\n466\t\n467\t    iv is nan where the bar cannot be priced: no spot in its minute, at or past settlement,\n468\t    or a price no vol reproduces (below intrinsic, or no time value left to resolve).\n469\t    \"\"\"\n470\t    out = df.copy()\n471\t    out[\"strike\"] = out.strike.astype(float)  # nullable Float64 -> float\n472\t    out[\"settlement\"] = out.option_root.map(lambda root: product.settlement(root).value)\n473\t    out[\"T\"] = time_to_settlement(out.timestamp, out.expiration, out.settlement)\n474\t    out[\"r\"], out[\"discount\"], out[\"forward\"] = curve_forward(out.spot, out[\"T\"], curve, dividend_yield)\n475\t    out[\"k\"] = np.log(out.strike / out.forward)\n476\t\n477\t    right = np.where(out.option_type == \"call\", 1, -1)\n478\t    priceable = (out[\"T\"] > 0) & out.spot.notna()\n479\t    iv = implied_vol(out.option_close, out.forward, out.strike, np.maximum(out[\"T\"], 1e-12),\n480\t                     out.discount, right)\n481\t    out[\"iv\"] = np.where(priceable, iv, np.nan)\n482\t    return out\n483\t\n484\t\n485\tdef contract_vol_summary(df_iv: pd.DataFrame) -> pd.DataFrame:\n486\t    \"\"\"One row per contract (root, expiry, strike, call/put), volume-weighted over its bars.\n487\t\n488\t    ``otm`` marks puts struck below the forward and calls at or above it: the side whose\n489\t    price is mostly time value, and so the reliable vol at that strike.\n490\t    \"\"\"\n491\t    bars = df_iv[df_iv.iv.notna()].assign(weight=lambda b: b.option_volume.astype(float))\n492\t    keys = [\"option_root\", \"expiration\", \"strike\", \"option_type\"]\n493\t    weighted = bars[[\"T\", \"forward\", \"k\", \"iv\", \"option_close\"]].mul(bars.weight, axis=0)\n494\t    weighted[keys] = bars[keys]\n495\t    grouped = weighted.groupby(keys)\n496\t    volume = bars.groupby(keys).weight.sum()\n497\t\n498\t    summary = grouped[[\"T\", \"forward\", \"k\", \"iv\", \"option_close\"]].sum().div(volume, axis=0)\n499\t    summary = summary.rename(columns={\"option_close\": \"price\"})\n500\t    summary[\"volume\"] = volume\n501\t    summary[\"n_bars\"] = bars.groupby(keys).size()\n502\t    summary = summary.reset_index()\n503\t    summary[\"otm\"] = np.where(summary.option_type == \"call\", summary.k >= 0, summary.k < 0)\n504\t    summary[\"total_variance\"] = summary.iv**2 * summary[\"T\"]\n505\t    return summary.sort_values([\"expiration\", \"strike\", \"option_type\"], ignore_index=True)\n506\t\n507\t\n508\tpar = RatesDataLoader(RATES_PROVIDER, data_dir=DATA_DIR).yields_as_of(\"2026-09-08\", lag_days=0)\n509\ttreasury_curve = treasury_zero_curve(par.tenors, par.yields_pct)\n510\t\n511\tdf_calibration_iv = contract_implied_vols(df_calibration, treasury_curve)\n512\tcontract_vols = contract_vol_summary(df_calibration_iv)\n513\tprint(f\"{df_calibration_iv.iv.notna().sum()} of {len(df_calibration_iv)} bars have an implied vol; \"\n514\t      f\"{len(contract_vols)} contracts, {contract_vols.otm.sum()} out of the money\")\n515\tcontract_vols\n516\t\n517\t--out: 13291 of 13548 bars have an implied vol; 2975 contracts, 2439 out of the money\n518\t\n519\t--data keys: ['text/html', 'text/plain']      option_root expiration  strike option_type         T      forward  \\\n520\t0           SPXW 2026-09-08  7150.0         put  0.000029  7680.435927   \n521\t1           SPXW 2026-09-08  7305.0         put  0.000015  7673.653158   \n522\t2           SPXW 2026-09-08  7375.0         put  0.000055  7684.671465   \n523\t3           SPXW 2026-09-08  7400.0         put  0.000013  7672.132763   \n524\t4           SPXW 2026-09-08  7425.0        call  0.000023  7679.914741   \n525\t...          ...        ...     ...         ...       ..\n526\t=== [16] code exec=None\n527\t### implied vol visualization\n528\t=== [17] code exec=128\n529\t### visualize the implied vol surface\n530\t# plot_vol_surface: left, each expiry's smile (iv against log-moneyness k = ln(K/F)), coloured\n531\t# on one light-to-dark blue ramp by time to expiry; right, the at-the-money term structure\n532\t# (each smile's iv interpolated to k = 0). plot_vol_surface_3d: the same points as a surface\n533\t# over (k, T), interpolated onto a grid, for a shape overview -- read values from the 2D view.\n534\timport matplotlib.pyplot as plt\n535\tfrom matplotlib.colors import LinearSegmentedColormap, LogNorm\n536\tfrom scipy.interpolate import griddata\n537\t\n538\tSURFACE, INK, INK_2, MUTED, GRID = \"#fcfcfb\", \"#0b0b0b\", \"#52514e\", \"#898781\", \"#e1e0d9\"\n539\tEXPIRY_CMAP = LinearSegmentedColormap.from_list(\"expiry\", [\"#86b6ef\", \"#3987e5\", \"#1c5cab\", \"#0d366b\"])\n540\t\n541\t\n542\tdef surface_input(contract_vols: pd.DataFrame, min_days: float = 1.0, min_price: float = 0.05,\n543\t                  max_abs_k: float = 1.0) -> pd.DataFrame:\n544\t    \"\"\"The out-of-the-money contracts a surface is read from, inside |k| <= max_abs_k sqrt(T).\"\"\"\n545\t    v = contract_vols\n546\t    keep = (v.otm & (v[\"T\"] * 365 >= min_days) & (v.price >= min_price)\n547\t            & (v.k.abs() <= max_abs_k * np.sqrt(v[\"T\"])))\n548\t    return v[keep].assign(days=lambda d: d[\"T\"] * 365).sort_values([\"expiration\", \"k\"])\n549\t\n550\t\n551\tdef atm_vols(points: pd.DataFrame) -> pd.DataFrame:\n552\t    \"\"\"Each expiry's iv at k = 0, interpolated linearly in k; only where the smile spans k = 0.\"\"\"\n553\t    rows = []\n554\t    for expiry, g in points.groupby(\"expiration\"):\n555\t        if g.k.min() < 0 <= g.k.max():\n556\t            rows.append({\"expiration\": expiry, \"days\": g.days.mean(), \"atm_iv\": np.interp(0.0, g.k, g.iv)})\n557\t    return pd.DataFrame(rows)\n558\t\n559\t\n560\tdef _style(ax):\n561\t    ax.set_facecolor(SURFACE)\n562\t    ax.grid(True, color=GRID, linewidth=0.6)\n563\t    ax.tick_params(colors=MUTED)\n564\t    for side in (\"top\", \"right\"):\n565\t        ax.spines[side].set_visible(False)\n566\t    for side in (\"left\", \"bottom\"):\n567\t        ax.spines[side].set_color(MUTED)\n568\t\n569\t\n570\tdef plot_vol_surface(contract_vols: pd.DataFrame, standardized: bool = False,\n571\t                     title: str = \"SPX implied vol surface\", **filters):\n572\t    \"\"\"Smiles by expiry and the ATM term structure, from contract_vol_summary output.\n573\t\n574\t    ``standardized`` plots the smiles against k / sqrt(T): the range of strikes that trade\n575\t    widens like sqrt(T), so on this axis every expiry's smile spans a similar width.\n576\t    \"\"\"\n577\t    points = surface_input(contract_vols, **filters)\n578\t    x = points.k / np.sqrt(points[\"T\"]) if standardized else points.k\n579\t    norm = LogNorm(vmin=points.days.min(), vmax=points.days.max())\n580\t    fig, (ax_smile, ax_term) = plt.subplots(1, 2, figsize=(13, 5), facecolor=SURFACE,\n581\t                                            gridspec_kw={\"width_ratios\": [1.6, 1]})\n582\t\n583\t    for expiry, g in points.groupby(\"expiration\"):\n584\t        color = EXPIRY_CMAP(norm(g.days.mean()))\n585\t        ax_smile.plot(x[g.index], 100 * g.iv, color=color, linewidth=1.2, alpha=0.9)\n586\t        ax_smile.scatter(x[g.index], 100 * g.iv, s=10, color=color, edgecolors=\"none\")\n587\t    ax_smile.axvline(0, color=MUTED, linewidth=0.8, linestyle=(0, (3, 3)))\n588\t    ax_smile.set(xlabel=\"k / sqrt(T)\" if standardized else \"log-moneyness k = ln(K / F)\",\n589\t                 ylabel=\"implied vol (%)\")\n590\t    ax_smile.set_title(\"Smile by expiry (puts left of 0, calls right)\", loc=\"left\", color=INK, fontsize=10)\n591\t    colorbar = fig.colorbar(plt.cm.ScalarMappable(norm=norm, cmap=EXPIRY_CMAP), ax=ax_smile, pad=0.01)\n592\t    colorbar.set_label(\"days to expiry\", color=INK_2)\n593\t    colorbar.ax.tick_params(colors=MUTED)\n594\t\n595\t    atm = atm_vols(points)\n596\t    ax_term.plot(atm.days, 100 * atm.atm_iv, color=\"#2a78d6\", linewidth=2)\n597\t    ax_term.scatter(atm.days, 100 * atm.atm_iv, s=36, color=\"#2a78d6\", edgecolors=SURFACE, linewidths=2, zorder=3)\n598\t    ax_term.set_xscale(\"log\")\n599\t    ax_term.set(xlabel=\"days to expiry (log)\", ylabel=\"ATM implied vol (%)\")\n600\t    ax_term.set_title(\"At-the-money term structure\", loc=\"left\", color=INK, fontsize=10)\n601\t\n602\t    for ax in (ax_smile, ax_term):\n603\t        _style(ax)\n604\t        ax.xaxis.label.set_color(INK_2)\n605\t        ax.yaxis.label.set_color(INK_2)\n606\t    fig.suptitle(f\"{title}: {len(points)} out-of-the-money contracts, {points.expiration.nunique()} expiries\",\n607\t                 color=INK, x=0.01, ha=\"left\")\n608\t    fig.tight_layout()\n609\t    return fig\n610\t\n611\t\n612\tdef plot_vol_surface_3d(contract_vols: pd.DataFrame, max_days: float = 120, grid_size: int = 60,\n613\t                        elev: float = 25, azim: float = -60, **filters):\n614\t    \"\"\"The surface over (k, days), linearly interpolated onto a grid inside the quoted points.\"\"\"\n615\t    points = surface_input(contract_vols, **filters)\n616\t    points = points[points.days <= max_days]\n617\t    k = np.linspace(points.k.min(), points.k.max(), grid_size)\n618\t    days = np.linspace(points.days.min(), points.days.max(), grid_size)\n619\t    K, D = np.meshgrid(k, days)\n620\t    iv = griddata((points.k, points.days), 100 * points.iv, (K, D), method=\"linear\")\n621\t\n622\t    fig = plt.figure(figsize=(9, 6.5), facecolor=SURFACE)\n623\t    ax = fig.add_subplot(projection=\"3d\", facecolor=SURFACE)\n624\t    for axis in (ax.xaxis, ax.yaxis, ax.zaxis):\n625\t        axis.set_pane_color(SURFACE)\n626\t        axis._axinfo[\"grid\"][\"color\"] = GRID\n627\t    ax.tick_params(colors=MUTED)\n628\t    ax.plot_surface(K, D, iv, cmap=EXPIRY_CMAP.reversed(), linewidth=0, antialiased=True, alpha=0.9)\n629\t    ax.scatter(points.k, points.days, 100 * points.iv, s=4, color=INK_2, alpha=0.5)\n630\t    ax.set_xlabel(\"k = ln(K / F)\", color=INK_2)\n631\t    ax.set_ylabel(\"days to expiry\", color=INK_2)\n632\t    ax.set_zlabel(\"implied vol (%)\", color=INK_2)\n633\t    ax.view_init(elev=elev, azim=azim)\n634\t    ax.set_title(f\"Implied vol surface, expiries up to {max_days:.0f} days\", loc=\"left\", color=INK)\n635\t    fig.tight_layout()\n636\t    return fig\n637\t\n638\t\n639\tfig = plot_vol_surface(contract_vols)\n640\tplt.show()\n641\t--data keys: ['image/png', 'text/plain'] <Figure size 1300x500 with 3 Axes>\n642\t=== [18] code exec=None\n643\t### filtering out the underlying ticker is \n644\t=== [19] code exec=129\n645\t1\n646\t--data keys: ['text/plain'] 1\n647\t=== [20] code exec=None\n648\t\n649\t",
            "locations": [
